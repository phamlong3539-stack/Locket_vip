 */
function hamVaForceOverride(entries) {
  if (!entries || typeof entries !== "object") return;

  // Cưỡng chế thời lượng video tối đa thành 45.0 giây
  const videoDurationKeys = [
    "max_video_duration",
    "video_max_duration",
    "camera_roll_max_duration",
    "camera_roll_video_max_duration",
    "camera_roll_duration",
    "video_trim_max_duration",
    "trim_max_duration",
    "gold_max_duration",
    "goldMaxDuration"
  ];
  for (let i = 0; i < videoDurationKeys.length; i++) {
    entries[videoDurationKeys[i]] = "45.0";
  }

  // Kích hoạt toàn bộ cờ Gold
  entries["is_gold"] = "true";
  entries["has_gold"] = "true";
  entries["is_gold_user"] = "true";
  entries["user_is_gold"] = "true";
  entries["gold_user"] = "true";
